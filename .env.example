# ==============================================================================
# Radar environment. Copy to .env (git-ignored, chmod 600) and fill in your values.
# Never commit, print or paste the values.
# ==============================================================================

# === Lake (default: <repo>/lake) ===
RADAR_LAKE=

# === Google Cloud / BigQuery (auth: gcloud auth application-default login) ===
GCP_PROJECT_ID=
BQ_DATASET=radar
BQ_MAX_BYTES_BILLED_GIB=50

# === LLM labeling and decisions ===
NEBIUS_API_KEY=
OPENROUTER_API_KEY=
CURATOR_TEACHER_MODELS=
JEV_MODEL=
JEV_RUN_CAP_USD=
JEV_DEV_CAP_USD=

# === Cross-source ===
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
WIKIMEDIA_USER_AGENT=

# === Graph visualization ===
GRAPHISTRY_USERNAME=
GRAPHISTRY_PASSWORD=

# LangSmith tracing and evals of the agents (agents/README.md). Traces hold questions, answers and
# tool results (public GDELT aggregates; no titles, URLs or person names).
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
LANGSMITH_PROJECT=radar-agents

# === Deploy (WS8, deploy/README.md) ===
# The Netlify site id for `npx netlify-cli deploy --site`. The Nebius key for the deployed API lives
# in Secret Manager (radar-nebius-key), never in a file.
NETLIFY_SITE_ID=
