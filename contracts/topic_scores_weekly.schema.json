{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LEONOB2014/Blinky/contracts/topic_scores_weekly.schema.json",
  "title": "One ranked topic in one week: the six scores, the decision and its reasons",
  "description": "WS4 Signal analyst -> lake/gold/topic_scores_weekly.parquet; the API and the Media Master read it",
  "type": "object",
  "x-owner": "WS4",
  "x-mock": "pending-dev-slice",
  "properties": {
    "week": {
      "type": "string",
      "pattern": "^[0-9]{4}-W[0-9]{2}$"
    },
    "topic_id": {
      "type": "string"
    },
    "label_es": {
      "type": "string"
    },
    "subtopics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "primary_subtopic": {
      "type": "string"
    },
    "emergence_pct": {
      "type": [
        "number",
        "null"
      ],
      "description": "Emergence percentile, 0..100"
    },
    "stage": {
      "type": "string",
      "enum": [
        "semilla",
        "emergente",
        "en_pico",
        "saturado",
        "en_declive"
      ]
    },
    "saturation": {
      "type": [
        "number",
        "null"
      ],
      "description": "0..1"
    },
    "audience_fit": {
      "type": [
        "number",
        "null"
      ],
      "description": "0..1 (Jev 0-4 rescaled)"
    },
    "outperformance": {
      "type": [
        "number",
        "null"
      ],
      "description": "ratio vs creator baseline; null without exemplars"
    },
    "emotional_charge_pct": {
      "type": [
        "number",
        "null"
      ],
      "description": "0..100"
    },
    "framing_angle": {
      "type": [
        "string",
        "null"
      ]
    },
    "window": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "dias_restantes",
            "en_cualquier_momento",
            "ya_en_espanol",
            "sin_estimacion"
          ]
        },
        "days_left": {
          "type": [
            "integer",
            "null"
          ]
        },
        "typical_lag_days": {
          "type": [
            "number",
            "null"
          ]
        },
        "n_onsets": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "state",
        "days_left",
        "n_onsets"
      ],
      "additionalProperties": false
    },
    "priority": {
      "type": "number"
    },
    "rank": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "publicar_ahora",
        "preparar",
        "esperar",
        "no_es_tema_caliente"
      ],
      "description": "computed by code from the scores, never by the LLM"
    },
    "why": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 5
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "gkg_id values; headlines and URLs are resolved from the lake at serve time"
    },
    "has_wikipedia_es_pt": {
      "type": "boolean"
    },
    "profile": {
      "type": "string",
      "enum": [
        "dev",
        "full"
      ]
    }
  },
  "required": [
    "week",
    "topic_id",
    "label_es",
    "primary_subtopic",
    "stage",
    "window",
    "priority",
    "decision",
    "why",
    "evidence_ids",
    "profile"
  ],
  "additionalProperties": false
}
