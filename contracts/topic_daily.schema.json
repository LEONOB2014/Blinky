{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LEONOB2014/Blinky/contracts/topic_daily.schema.json",
  "title": "Day x ranked topic (entity or theme inside ring 1) x language: the backtest's series",
  "description": "BigQuery radar.topic_daily from radar.gkg_ai orgs and themes (design: What is ranked) -> lake/gold/topic_daily.parquet",
  "type": "object",
  "x-owner": "WS1",
  "x-mock": "dev-slice",
  "properties": {
    "topic_id": {
      "type": "string",
      "description": "'org:<name>' or 'thm:<GKG theme>'; persons are never ranked"
    },
    "dt": {
      "type": "string",
      "format": "date"
    },
    "lang_bucket": {
      "type": "string",
      "enum": [
        "eng",
        "spa",
        "por",
        "other"
      ]
    },
    "segment": {
      "const": "ai"
    },
    "n_articles": {
      "type": "integer",
      "minimum": 0,
      "description": "ring-1 articles mentioning the topic"
    },
    "share_of_day": {
      "type": [
        "number",
        "null"
      ],
      "description": "n_articles / daily_totals.n_all"
    },
    "mean_tone": {
      "type": [
        "number",
        "null"
      ],
      "description": ""
    },
    "mean_polarity": {
      "type": [
        "number",
        "null"
      ],
      "description": ""
    },
    "is_missing": {
      "type": "boolean"
    }
  },
  "required": [
    "topic_id",
    "dt",
    "lang_bucket",
    "segment",
    "n_articles",
    "share_of_day",
    "is_missing"
  ],
  "additionalProperties": false
}
