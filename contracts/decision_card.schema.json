{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LEONOB2014/Blinky/contracts/decision_card.schema.json",
  "title": "The Media Master's answer about one topic: decision, KPIs and justification",
  "description": "agents/ runtime -> API -> web. Every KPI cites the tool call that produced it.",
  "type": "object",
  "x-owner": "orchestrator (agents/)",
  "x-mock": "pending-first-agent-run",
  "properties": {
    "topic_id": {
      "type": "string"
    },
    "week": {
      "type": "string",
      "pattern": "^[0-9]{4}-W[0-9]{2}$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "publicar_ahora",
        "preparar",
        "esperar",
        "no_es_tema_caliente"
      ]
    },
    "kpis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "measured",
              "estimate"
            ]
          },
          "source": {
            "type": "string",
            "description": "the tool call id that produced it"
          }
        },
        "required": [
          "name",
          "value",
          "kind",
          "source"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "justification_es": {
      "type": "string"
    },
    "context_1hop": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 20
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 5
    },
    "suggested_content": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "format": {
          "type": "string"
        },
        "hooks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outline": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "auditor_ok": {
      "type": "boolean",
      "description": "the Auditor found every number traced to a tool result"
    }
  },
  "required": [
    "topic_id",
    "week",
    "decision",
    "kpis",
    "justification_es",
    "evidence_ids",
    "auditor_ok"
  ],
  "additionalProperties": false
}
